# Abel environment variables
# Copy to .env.local for local development. Never commit .env.local.

# ── LLM Providers ─────────────────────────────────────────────────────────────
# Leave empty to use Mock Abel (no API key required).
# Set one of these to enable real AI responses.

VITE_ANTHROPIC_API_KEY=        # Claude (Anthropic)
VITE_OPENAI_API_KEY=           # ChatGPT (OpenAI)
VITE_OLLAMA_BASE_URL=          # Local model (e.g. http://localhost:11434)

# ── Database (future server-side) ─────────────────────────────────────────────
# Not required for local development — app uses IndexedDB (Dexie) in the browser.
# These will be needed when a backend/API layer is added.

DATABASE_URL=                  # e.g. postgresql://user:pass@host:5432/abel
DATABASE_DIRECT_URL=           # for Prisma migrations behind a connection pooler

# ── Auth (future) ─────────────────────────────────────────────────────────────
# Not required for local development. Add when implementing real multi-user auth.

VITE_AUTH_SECRET=
VITE_AUTH_URL=                 # e.g. http://localhost:5173

# ── Storage (future) ──────────────────────────────────────────────────────────
# For file uploads, memory attachments, voice notes, etc.

VITE_STORAGE_URL=

# ── Analytics (optional) ──────────────────────────────────────────────────────
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=

# ── Feature flags ─────────────────────────────────────────────────────────────
VITE_ENABLE_VECTOR_SEARCH=false   # enable embedding-based memory search
VITE_ENABLE_SYNC_JOBS=false       # enable background job worker

# ── Billing & Stripe ──────────────────────────────────────────────────────────
# Stripe integration for subscription billing
VITE_STRIPE_PUBLISHABLE_KEY=      # pk_test_... for Stripe checkout
VITE_STRIPE_WEBHOOK_SECRET=       # whsec_... for webhook signature validation
VITE_STRIPE_PRICE_LOOKUP_KEY=     # price_... for dynamic pricing lookup
VITE_STRIPE_SANDBOX_MODE=true     # enable sandbox/test flows in dev

# ── Admin & Dev Panels ────────────────────────────────────────────────────────
VITE_ABEL_ENABLE_ADMIN_PANELS=false    # enable admin/dev-only panels in UI
VITE_ABEL_ENABLE_SIMULATION_TOOLS=false # enable scale simulation tools
VITE_ABEL_ENABLE_COST_LAB=false         # enable provider cost lab

# ── Payment Options ──────────────────────────────────────────────────────────
# Accepted payment methods (comma-separated; leave empty for default)
VITE_ACCEPTED_PAYMENT_METHODS=card      # e.g. card,paypal,crypto,bank_transfer
VITE_DEFAULT_CURRENCY=usd               # ISO 4217 currency code
VITE_TRIAL_ENABLED=true                 # enable free trial period
VITE_REFERRAL_ENABLED=true               # enable referral program
VITE_CREDIT_PACKS_ENABLED=true           # enable one-time credit pack purchases
